#!/usr/bin/env bash
set -euo pipefail

# Scaffold a new persona: a voice-channel template AND its Tier 2 shim skill,
# both written into the dotfiles stow source (version-controlled, private).
# After scaffolding, `stow` symlinks the persona file into $XDG_CONFIG_HOME,
# where the generic skills' Resolver finds it.
#
# Voice channel only (tracer scope, issue #4). Email + multi-channel arrive in
# a follow-up slice (issue #7).
#
# Usage:
#   ./bin/persona-init <slug> [--dry-run]
#
# Requires:
#   - STONEMATT_DOTFILES_DIR (path to the dotfiles repo root, must contain a
#     stonematt-skills/ stow package).
#
# Writes (idempotent — skips files that already exist):
#   $STONEMATT_DOTFILES_DIR/stonematt-skills/dot-config/stonematt-skills/persona/<slug>/voice.md
#   $STONEMATT_DOTFILES_DIR/stonematt-skills/dot-claude/skills/<slug>-voice/SKILL.md

slug=""
dry_run=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=1 ;;
    -*) echo "error: unknown flag '$arg'" >&2; exit 1 ;;
    *)
      if [ -n "$slug" ]; then
        echo "error: unexpected argument '$arg'" >&2; exit 1
      fi
      slug="$arg"
      ;;
  esac
done

if [ -z "$slug" ]; then
  echo "usage: $0 <slug> [--dry-run]" >&2
  exit 1
fi

# Validate slug.
if ! [[ "$slug" =~ ^[a-z][a-z0-9-]*$ ]]; then
  echo "error: slug must be lowercase letters/digits/hyphens, starting with a letter (got: '$slug')" >&2
  exit 1
fi

dotfiles="${STONEMATT_DOTFILES_DIR:-}"
if [ -z "$dotfiles" ]; then
  echo "error: STONEMATT_DOTFILES_DIR is not set" >&2
  echo "  export STONEMATT_DOTFILES_DIR=/path/to/dotfiles" >&2
  exit 1
fi

stow_pkg="$dotfiles/stonematt-skills"
if [ ! -d "$stow_pkg" ]; then
  echo "error: stow package not found at $stow_pkg" >&2
  echo "  expected: $dotfiles/stonematt-skills/" >&2
  exit 1
fi

persona_file="$stow_pkg/dot-config/stonematt-skills/persona/$slug/voice.md"
shim_file="$stow_pkg/dot-claude/skills/$slug-voice/SKILL.md"

# Write $1 (target path) with the content on stdin, unless it exists. Honors
# --dry-run. Sets `wrote_any=1` when a real write happens.
wrote_any=0
write_if_absent() {
  local target="$1"
  if [ -f "$target" ]; then
    echo "skip (exists): $target"
    cat >/dev/null   # drain stdin
    return 0
  fi
  if [ "$dry_run" -eq 1 ]; then
    echo "would write:   $target"
    cat >/dev/null
    return 0
  fi
  mkdir -p "$(dirname "$target")"
  cat >"$target"
  echo "wrote:         $target"
  wrote_any=1
}

write_if_absent "$persona_file" <<EOF
# $slug — voice channel

Voice fingerprint for the \`$slug\` persona. Loaded by the generic \`voice\` and
\`email\` skills via the Resolver. Edit this file with real voice rules; it ships
in claude.ai bundles, so keep it free of secrets you would not upload.

Hybrid shape (see ADR-0001): bullet style rules + numeric targets + labeled
Input/Output few-shot pairs + explicit anti-patterns.

## Style rules

- (rule 1 — e.g. first person, present tense)
- (rule 2)
- (rule 3)
- (5 to 15 rules total)

## Numeric targets

- Sentence length: (median words)
- Paragraph count: (range for a short note)

## Few-shot examples

**Input:** (a prompt this persona would respond to)
**Output:** (the response in this persona's voice)

**Input:** (another prompt)
**Output:** (another response)

(3 to 5 pairs)

## Anti-patterns

- Never (open with a specific cliché this persona avoids)
- Never (another tell)
EOF

write_if_absent "$shim_file" <<EOF
---
name: $slug-voice
description: >
  Write or review prose in the $slug persona's voice. Triggers on "write as
  $slug", "$slug voice", "draft this as $slug", "review for $slug voice", and
  /$slug-voice. Delegates to the generic \`voice\` skill with --persona $slug.
argument-hint: "[--skip-sniff] <draft or review request>"
---

# $slug-voice (Tier 2 shim)

Thin persona-named entry point. Holds no identity content — the voice lives in
the resolved persona file.

Invoke the generic \`voice\` skill with \`--persona $slug\`, forwarding the
user's draft-or-review request and any \`--skip-sniff\` flag.
EOF

echo
if [ "$dry_run" -eq 1 ]; then
  echo "dry run — no files written."
elif [ "$wrote_any" -eq 1 ]; then
  echo "next steps:"
  echo "  1. edit $persona_file with real voice rules"
  echo "  2. stow the package:  stow -d \"$dotfiles\" stonematt-skills"
  echo "     (symlinks the persona file into \$XDG_CONFIG_HOME and the shim into ~/.claude/skills)"
else
  echo "nothing to do — all targets already exist."
fi
