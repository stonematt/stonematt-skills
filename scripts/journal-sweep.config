# journal-sweep configuration — sourced by journal-sweep.sh
# shellcheck shell=bash disable=SC2034

# Root of the repo tree to walk.
ROOT="${HOME}/src"

# GitHub accounts/orgs you OWN. Used for the discover path only
# (owned repos with no .journal yet -> surfaced to Obsidian inbox).
# Space-separated. W3C member-only orgs deliberately excluded.
ALLOWLIST="stonematt thebrightlink eko-one thenorthwesthub nrthe-com astrarum skivalet"

# Per-repo dispatch timeout (seconds).
TIMEOUT=300

# Max concurrent headless journal runs.
CONCURRENCY=3

# Model for the headless /stone-journal runs.
MODEL=sonnet

# Permission mode for headless claude (cron has no TTY; must not prompt).
# bypassPermissions is required for true unattended operation.
PERMISSION_MODE=bypassPermissions

# Author filter for staleness. Empty = ANY commit counts as new work (Q8a).
# To restrict to your own commits, set a pipe-separated email regex,
# e.g. AUTHORS="mstone@stonecover.com|matt@example.com"
AUTHORS=""

# Outputs.
LOG="${HOME}/Library/Logs/journal-sweep.log"
STATE_DIR="${HOME}/.local/state/journal-sweep"

# Discover-candidate queue. launchd may run while Obsidian is closed, so we do
# NOT call the obsidian CLI — we append owned-but-unjournaled repos to this
# plain markdown file. Point your Obsidian daily processor at it to ingest.
DISCOVER_QUEUE="${HOME}/.local/state/journal-sweep/discover-queue.md"

# Desktop notification on attention (failures / new discover). 1=on, 0=off.
NOTIFY=1
