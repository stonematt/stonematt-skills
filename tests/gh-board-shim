#!/usr/bin/env bash
# Fake `gh` for the pocock-board Projects-v2 helper (Seam 2, offline).
# Point POCOCK_GH at this script.
#
#   gh api graphql -f query='<mutation ...>' -f k=v ...
#     -> appends "<mutation-name>\t<flattened query>\t<bindings, flag included>" to
#        $GH_GQL_LOG, and prints canned response JSON so the helper can parse
#        back the field / option / item ids it captures.
#   anything else -> no-op success
set -u

if [ "${1:-}" = "api" ] && [ "${2:-}" = "graphql" ]; then
  shift 2
  query=""; fields=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -f) case "${2:-}" in
            query=*) query="${2#query=}" ;;
            *)       fields="$fields -f ${2:-}" ;;
          esac; shift 2 ;;
      -F) fields="$fields -F ${2:-}"; shift 2 ;;
      *)  shift ;;
    esac
  done

  # Identify the mutation by name.
  mut="unknown"
  case "$query" in
    *updateProjectV2ItemFieldValue*) mut="updateProjectV2ItemFieldValue" ;;
    *updateProjectV2Field*)          mut="updateProjectV2Field" ;;
    *addProjectV2ItemById*)          mut="addProjectV2ItemById" ;;
  esac

  if [ -n "${GH_GQL_LOG:-}" ]; then
    # Flatten the query to a single line so grep-style assertions can see the
    # whole payload (singleSelectOptions, singleSelectOptionId, colors, …).
    flat="$(printf '%s' "$query" | tr '\n' ' ')"
    printf '%s\t%s\t%s\n' "$mut" "$flat" "$fields" >> "$GH_GQL_LOG"
  fi

  case "$mut" in
    updateProjectV2Field)
      cat <<'JSON'
{"data":{"updateProjectV2Field":{"projectV2Field":{"id":"FIELD_STATUS","options":[
{"id":"opt_triage","name":"Triage"},
{"id":"opt_ready","name":"Ready"},
{"id":"opt_wip","name":"WIP"},
{"id":"opt_staged","name":"Staged"},
{"id":"opt_blocked","name":"Blocked"},
{"id":"opt_released","name":"Released"}]}}}}
JSON
      ;;
    addProjectV2ItemById)
      echo '{"data":{"addProjectV2ItemById":{"item":{"id":"ITEM_NEW"}}}}'
      ;;
    updateProjectV2ItemFieldValue)
      echo '{"data":{"updateProjectV2ItemFieldValue":{"projectV2Item":{"id":"ITEM_NEW"}}}}'
      ;;
    *)
      echo '{"data":{}}'
      ;;
  esac
  exit 0
fi
exit 0
